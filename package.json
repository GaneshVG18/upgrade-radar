{
  "name": "upgrade-radar",
  "version": "0.1.2",
  "private": true,
  "description": "Evidence-linked dependency upgrade review for TypeScript, powered by Jev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {"upgrade-radar": "dist/cli.js"},
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "npm run build && vitest run",
    "test:compat": "node scripts/compat.mjs",
    "corpus:generate": "node scripts/build-corpus.mjs",
    "notes:manifest": "node scripts/update-notes-manifest.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node dist/cli.js demo --out artifacts/demo",
    "eval:live": "node scripts/eval-live.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:compat && npm run build && npm run smoke"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "marked": "18.0.13",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/semver": "7.7.1",
    "express4": "npm:express@4.21.2",
    "express5": "npm:express@5.1.0",
    "oxlint": "1.83.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod3": "npm:zod@3.25.76",
    "zod4": "npm:zod@4.1.5"
  }
}
